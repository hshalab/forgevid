// Support Tickets
model SupportTicket {
  id          String   @id @default(cuid())
  subject     String
  description String
  priority    String   // e.g. "low", "medium", "high"
  category    String   // e.g. "general", "billing", etc.
  status      String   @default("open") // "open", "closed", "pending"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])

  @@map("support_tickets")
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}
// ForgeVid Production Database Schema (PostgreSQL)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User Management
model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String?
  image          String?
  emailVerified  DateTime?
  password       String?
  role           UserRole  @default(USER)
  status         UserStatus @default(ACTIVE)
  mfaEnabled     Boolean   @default(false)
  mfaSecret      String?
  lastLogin      DateTime?
  lastLoginAt    DateTime?
  // Password reset: SHA-256 hash of the emailed token (never the raw token) + expiry.
  resetTokenHash   String?
  resetTokenExpiry DateTime?
  metadata       String?   // JSON string for additional user data
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Subscription information
  subscription   Json?     // Stripe subscription data

  // Organization relationship
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])


  // User relationships
  videos         Video[]
  collaborations CollaborationRoom[]
  collaborationMemberships CollaborationMember[]
  usageRecords   UsageRecord[]
  subscriptions  Subscription[]
  payments       Payment[]
  analytics      UserAnalytics[]
  notifications  Notification[]
  sessions       Session[]
  apiKeys        ApiKey[]
  videoEdits     VideoEdit[]
  aiGenerations  AIGeneration[]
  collaborationMessages CollaborationMessage[]
  collaborationEdits CollaborationEdit[]
  templatesCreated Template[] @relation("TemplateCreatedBy")
  templateRatings  TemplateRating[] @relation("TemplateRatingUser")
  templateFavorites TemplateFavorite[] @relation("TemplateFavoriteUser")
  templateModerations TemplateModeration[] @relation("TemplateModerationUser")
  mediaAssetsUploaded MediaAsset[] @relation("MediaAssetUploadedBy")
  auditLogs      AuditLog[]
  supportTickets SupportTicket[]
  betaAccessEntriesCreated BetaAccessEntry[] @relation("BetaAccessCreatedBy")
  brandKit       BrandKit?
  clonedVoices   ClonedVoice[]
  creditLedgerEntries CreditLedger[]

  @@map("users")
  @@index([email])
  @@index([organizationId])
  @@index([status])
  @@index([createdAt])
}

model Organization {
  id          String @id @default(cuid())
  name        String
  domain      String? @unique
  logo        String?
  ssoEnabled  Boolean @default(false)
  ssoProvider SSOProvider?
  settings    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Organization relationships
  users       User[]
  videos      Video[]
  plans       OrganizationPlan[]
  invoices    Invoice[]
  ssoConfigurations SSOConfiguration[]

  @@map("organizations")
  @@index([name])
  @@index([domain])
}

model SSOConfiguration {
  id              String      @id @default(cuid())
  organizationId  String?
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider        SSOProvider
  enabled         Boolean     @default(false)
  metadata        Json?
  metadataUrl     String?
  issuer          String?
  clientId        String?
  clientSecret    String?
  tenantId        String?
  entityId        String?
  certificate     String?
  defaultRole     UserRole    @default(USER)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@map("sso_configurations")
  @@unique([provider, organizationId])
  @@index([organizationId])
  @@index([provider])
}

// Organization Plans
model OrganizationPlan {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  planType       PlanType
  name           String
  description    String?
  features       String? // JSON string of enabled features
  userLimit      Int?
  storageLimitGB Int?
  videoLimit     Int?
  priceUSD       Decimal?
  isActive       Boolean  @default(true)
  startDate      DateTime @default(now())
  endDate        DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relationships
  invoices       Invoice[]

  @@map("organization_plans")
  @@index([organizationId])
  @@index([planType])
  @@index([isActive])
}

enum PlanType {
  FREE
  STARTER
  PRO
  ENTERPRISE
  CUSTOM
}

// Video Management
model Video {
  id              String      @id @default(cuid())
  title           String
  description     String?
  status          VideoStatus @default(PROCESSING)
  duration        Int?        // in seconds
  resolution      String?     // "720p", "1080p", "4k"
  format          String?     // "mp4", "webm", "mov"
  fileSize        BigInt?     // in bytes
  thumbnail       String?
  url             String?
  fileUrl         String?     // Cloudinary URL
  transcript      String?     // AI-generated transcript
  summary         String?     // AI-generated summary
  metadata        String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Relationships
  userId          String
  organizationId  String?
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization    Organization? @relation(fields: [organizationId], references: [id])
  edits           VideoEdit[]
  exports         VideoExport[]
  analytics       VideoAnalytics[]

  @@map("videos")
  @@index([userId])
  @@index([organizationId])
  @@index([status])
  @@index([createdAt])
}

model VideoEdit {
  id        String   @id @default(cuid())
  type      String   // "trim", "crop", "filter", "text", "audio"
  data      String   // JSON string of edit configuration
  timestamp DateTime @default(now())

  // Relationships
  videoId   String
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])

  @@map("video_edits")
  @@index([videoId])
  @@index([userId])
  @@index([timestamp])
}

model VideoExport {
  id        String        @id @default(cuid())
  format    String        // "mp4", "webm", "mov", "gif"
  quality   String        // "low", "medium", "high", "ultra"
  status    ExportStatus  @default(PROCESSING)
  progress  Int           @default(0)
  url       String?
  fileUrl   String?       // CDN URL from Cloudinary
  fileSize  BigInt?
  createdAt DateTime      @default(now())

  // Relationships
  videoId   String
  video     Video         @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@map("video_exports")
  @@index([videoId])
  @@index([status])
}

// AI Features
model AIGeneration {
  id          String          @id @default(cuid())
  type        AIGenerationType
  prompt      String
  result      String?
  status      GenerationStatus @default(PROCESSING)
  tokensUsed  Int?
  cost        Decimal?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // Relationships
  userId      String
  user        User            @relation(fields: [userId], references: [id])

  @@map("ai_generations")
  @@index([userId])
  @@index([createdAt])
  @@index([type])
}

// Collaboration
model CollaborationRoom {
  id          String   @id @default(cuid())
  name        String
  description String?
  isActive    Boolean  @default(true)
  settings    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  members     CollaborationMember[]
  messages    CollaborationMessage[]
  edits       CollaborationEdit[]

  @@map("collaboration_rooms")
  @@index([createdById])
  @@index([isActive])
}

model CollaborationMember {
  id       String                @id @default(cuid())
  role     CollaborationRole     @default(VIEWER)
  joinedAt DateTime              @default(now())

  // Relationships
  userId   String
  user     User                  @relation(fields: [userId], references: [id])
  roomId   String
  room     CollaborationRoom     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([userId, roomId])
  @@map("collaboration_members")
}

model CollaborationMessage {
  id        String   @id @default(cuid())
  content   String
  type      MessageType @default(TEXT)
  createdAt DateTime @default(now())

  // Relationships
  roomId    String
  room      CollaborationRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId    String
  user      User              @relation(fields: [userId], references: [id])

  @@map("collaboration_messages")
  @@index([roomId])
}

model CollaborationEdit {
  id        String   @id @default(cuid())
  type      String   // "video_edit", "comment", "suggestion"
  data      String   // JSON string of edit data
  timestamp DateTime @default(now())

  // Relationships
  roomId    String
  room      CollaborationRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId    String
  user      User              @relation(fields: [userId], references: [id])

  @@map("collaboration_edits")
  @@index([roomId])
}

// Templates and Media
model Template {
  id          String         @id @default(cuid())
  name        String
  description String?
  category    TemplateCategory
  duration    Int            // in seconds
  aspectRatio String         // "16:9", "9:16", "1:1"
  resolution  String         // "720p", "1080p", "4k"
  tags        String?
  thumbnail   String
  previewUrl  String?
  templateData String        // JSON string of template configuration
  usageCount  Int            @default(0)
  rating      Decimal?
  isPublic    Boolean        @default(true)
  moderationStatus String?   @default("approved")  // "pending", "approved", "rejected", "flagged"
  totalRatings Int           @default(0)
  averageRating Decimal?
  favoriteCount Int          @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // Relationships
  createdById String?
  createdBy   User?          @relation("TemplateCreatedBy", fields: [createdById], references: [id])
  ratings     TemplateRating[]
  favorites   TemplateFavorite[]
  moderation  TemplateModeration?
  analytics   TemplateAnalytics[]

  @@unique([name])
  @@map("templates")
  @@index([moderationStatus])
  @@index([isPublic, favoriteCount, averageRating, usageCount, createdAt])
  @@index([category])
}

model TemplateRating {
  id        String   @id @default(cuid())
  rating    Decimal  @db.Decimal(3,2)
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  templateId String
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation("TemplateRatingUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([templateId, userId])
  @@map("template_ratings")
  @@index([templateId])
  @@index([userId])
}

model TemplateFavorite {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  // Relationships
  templateId String
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation("TemplateFavoriteUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([templateId, userId])
  @@map("template_favorites")
  @@index([templateId])
  @@index([userId])
}

model TemplateModeration {
  id             String   @id @default(cuid())
  status         String   @default("pending")  // "pending", "approved", "rejected", "flagged"
  moderatorId    String?
  rejectionReason String?
  moderatedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relationships
  templateId  String
  template    Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  moderator   User?    @relation("TemplateModerationUser", fields: [moderatorId], references: [id])

  @@unique([templateId])
  @@map("template_moderation")
  @@index([templateId])
  @@index([status])
}

model TemplateAnalytics {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  views     Int      @default(0)
  clicks    Int      @default(0)
  uses      Int      @default(0)
  favorites Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  templateId String
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, date])
  @@map("template_analytics")
  @@index([templateId])
  @@index([date])
}

model MediaAsset {
  id          String         @id @default(cuid())
  name        String
  fileName    String
  type        MediaType
  category    String?
  url         String
  thumbnail   String?
  duration    Int?           // for video/audio
  fileSize    BigInt?
  resolution  String?        // for images/video
  metadata    String?
  isPublic    Boolean        @default(false)
  createdAt   DateTime       @default(now())

  // Relationships
  uploadedById String?
  uploadedBy   User?         @relation("MediaAssetUploadedBy", fields: [uploadedById], references: [id])

  @@unique([name])
  @@map("media_assets")
}

model BetaAccessEntry {
  id          String   @id @default(cuid())
  email       String?  @unique
  inviteCode  String?  @unique
  note        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships
  createdById String?
  createdBy   User?    @relation("BetaAccessCreatedBy", fields: [createdById], references: [id])

  @@map("beta_access_entries")
  @@index([email])
  @@index([inviteCode])
  @@index([isActive])
}

// Usage and Analytics
model UsageRecord {
  id           String      @id @default(cuid())
  action       String      // "video_created", "ai_generation", "export"
  resourceType String?     // Type of resource being used
  quantity     Int         @default(1)
  metadata     String?
  cost         Decimal?
  timestamp    DateTime    @default(now())

  // Relationships
  userId    String
  user      User        @relation(fields: [userId], references: [id])

  @@map("usage_records")
  @@index([userId])
  @@index([action])
  @@index([timestamp])
  @@index([userId, action, timestamp])
}

model UserAnalytics {
  id        String   @id @default(cuid())
  date      DateTime
  videosCreated Int  @default(0)
  aiGenerations Int  @default(0)
  exportsGenerated Int @default(0)
  collaborationTime Int @default(0) // in minutes
  createdAt DateTime @default(now())

  // Relationships
  userId    String
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, date])
  @@map("user_analytics")
}

model VideoAnalytics {
  id        String   @id @default(cuid())
  views     Int      @default(0)
  shares    Int      @default(0)
  downloads Int      @default(0)
  duration  Int?     // total watch time in seconds
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  videoId   String
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@map("video_analytics")
  @@index([videoId])
  @@index([views])
  @@index([shares])
}

// Subscriptions and Payments
model Subscription {
  id                String           @id @default(cuid())
  status            SubscriptionStatus
  plan              String           // "free", "starter", "pro", "enterprise"
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd Boolean          @default(false)
  canceledAt        DateTime?
  metadata          String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  // Relationships
  userId            String
  user              User             @relation(fields: [userId], references: [id])
  payments          Payment[]

  @@map("subscriptions")
  @@index([userId])
  @@index([status])
  @@index([plan])
  @@index([canceledAt])
}

model Payment {
  id              String        @id @default(cuid())
  amount          Decimal
  currency        String        @default("usd")
  status          PaymentStatus
  stripePaymentId String?       @unique
  description     String?
  metadata        String?
  createdAt       DateTime      @default(now())
  // Excludes this payment from judged arms-length revenue (friends/family/
  // team). Defaults false; flip explicitly per row — never inferred.
  isRelatedParty  Boolean       @default(false)

  // Relationships
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  subscriptionId  String?
  subscription    Subscription? @relation(fields: [subscriptionId], references: [id])

  @@map("payments")
  @@index([userId])
  @@index([createdAt])
  @@index([status])
}

model Invoice {
  id              String      @id @default(cuid())
  number          String      @unique
  amount          Decimal
  currency        String      @default("usd")
  status          InvoiceStatus
  dueDate         DateTime
  paidAt          DateTime?
  createdAt       DateTime    @default(now())

  // Relationships
  organizationId  String?
  organization    Organization? @relation(fields: [organizationId], references: [id])
  planId          String?
  plan            OrganizationPlan? @relation(fields: [planId], references: [id])

  @@map("invoices")
}

// System Management
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  // Relationships
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model ApiKey {
  id        String   @id @default(cuid())
  name      String
  key       String   @unique
  lastUsed  DateTime?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  // Relationships
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("api_keys")
}

model Notification {
  id        String           @id @default(cuid())
  title     String
  message   String
  type      NotificationType
  read      Boolean          @default(false)
  data      String?
  createdAt DateTime         @default(now())

  // Relationships
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
  @@index([userId])
  @@index([read])
  @@index([userId, read])
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  resource  String
  details   String?
  ipAddress String?
  userAgent String?
  timestamp DateTime @default(now())
  createdAt DateTime @default(now())

  // Relationships
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])

  @@map("audit_logs")
  @@index([userId])
  @@index([timestamp])
  @@index([action])
}

// Enums
enum UserRole {
  ADMIN
  MANAGER
  USER
  VIEWER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING
  DELETED
}

enum SSOProvider {
  GOOGLE
  AZURE
  OKTA
  SAML
}

/// A voice cloned from the user's own recording via ElevenLabs voice-add.
/// providerVoiceId is the ElevenLabs voice id used for TTS. Pro plans only.
model ClonedVoice {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerVoiceId String
  name            String
  createdAt       DateTime @default(now())

  @@unique([userId, providerVoiceId])
  @@map("cloned_voices")
  @@index([userId])
}

/// Per-user branding applied at render time. Paid plans only (see lib/plan.ts).
model BrandKit {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Logo overlaid on the video (CDN url).
  logoUrl        String?
  /// 0.0-1.0, corner placement.
  logoOpacity    Float    @default(0.85)
  logoPosition   String   @default("bottom-right")

  /// Caption colour, as #RRGGBB.
  primaryColor   String?
  /// Absolute path or url of a .ttf used for captions.
  fontFamily     String?

  /// Short clips prepended/appended to every render (CDN urls).
  introUrl       String?
  outroUrl       String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("brand_kits")
  @@index([userId])
}

/// Purchased-credit ledger — the second of the two credit pools (see lib/quota.ts).
/// Append-only: a credit purchase is a +delta row, a generation paid for with a
/// purchased credit is a -delta row. Balance = SUM(delta) for the user; never
/// mutated in place, so it doubles as an audit trail. stripeSessionId is unique
/// so the Stripe webhook can retry `checkout.session.completed` without
/// double-granting (see lib/credits.ts grantCredits).
model CreditLedger {
  id              String   @id @default(cuid())
  userId          String
  /// +grant, -consume. Whole credits (1 credit = 1 video, per the product design).
  delta           Int
  /// purchase_single | purchase_topup10 | purchase_topup25 | consume_generation | refund_failed_render
  reason          String
  videoId         String?
  /// Idempotency key for webhook grants — @unique so a re-delivered Stripe event
  /// can't grant the same purchase twice.
  stripeSessionId String?  @unique
  createdAt       DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("credit_ledger")
  @@index([userId])
  @@index([videoId])
}

/// A user's own referral code (one row per user, created on first visit to the
/// Referrals page). The share link is /auth/signup?ref=<code>.
model ReferralAccount {
  id        String   @id @default(cuid())
  userId    String   @unique
  code      String   @unique
  createdAt DateTime @default(now())

  @@map("referral_accounts")
}

/// One row per referred sign-up. `converted` flips to true (and rewardCents is
/// credited) once the referred user takes a paid subscription — reconciled
/// lazily when the referrer views their Referrals page.
model ReferralSignup {
  id             String   @id @default(cuid())
  referrerId     String
  referredUserId String   @unique
  code           String
  converted      Boolean  @default(false)
  rewardCents    Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([referrerId])
  @@map("referral_signups")
}

/// Review comments on a video (async collaboration). Left by the owner or by
/// anyone with the public share link (metadata.shareEnabled); public reviewers
/// supply a display name, authenticated owners are linked by authorUserId.
model VideoComment {
  id           String   @id @default(cuid())
  videoId      String
  authorUserId String?
  authorName   String
  body         String
  timestampSec Int?
  createdAt    DateTime @default(now())

  @@index([videoId])
  @@map("video_comments")
}

/// Ad Studio: a marketing campaign — one concept generated into a matrix of ad
/// creatives (hook x CTA x placement) for a target platform.
model AdCampaign {
  id           String   @id @default(cuid())
  userId       String
  aiDecisionId String?
  name         String
  brief        String
  platform     String
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([aiDecisionId])
  @@map("ad_campaigns")
}

/// One ad variant in a campaign. Links to the generated Video and carries the
/// marketing axes under test plus performance (isWinner / roas) for the winners
/// library + "make more like this" loop.
model AdCreative {
  id                   String   @id @default(cuid())
  userId               String
  campaignId           String
  videoId              String?
  label                String
  hook                 String?
  cta                  String?
  aspect               String?
  platform             String
  /// Set by lib/ad-performance.ts ONLY for a creative with total* data
  /// imported below — a creative with none keeps whatever a customer set via
  /// the manual PATCH /api/ad-studio/creatives/[id] endpoint untouched.
  isWinner             Boolean  @default(false)
  roas                 Float?
  /// Ad spend/impressions/clicks the customer imported from their OWN ad
  /// platform dashboard (see lib/ad-performance.ts) — never pulled via an API,
  /// never inferred. LIFE-TO-DATE TOTALS, not a period delta: each import
  /// REPLACES the previous value (there is no per-period history), so
  /// importing must always upload the running total, the same way
  /// GrowthConversion's revenue is already a running lifetime sum.
  totalSpendCents      Int?
  totalImpressions     Int?
  totalClicks          Int?
  spendUpdatedAt       DateTime?
  notes                String?
  recommendationReason String?
  expectedResult       String?
  estimatedCostCents   Int?
  rightsStatus         String   @default("UNCONFIRMED") // "UNCONFIRMED" | "CONFIRMED"
  approvalStatus       String   @default("AWAITING_REVIEW") // "AWAITING_REVIEW" | "APPROVED" | "CHANGES_REQUESTED" | "REJECTED"
  revision             Int      @default(1)
  approvedRevision     Int?
  approvedAt           DateTime?
  approvedByUserId     String?
  reviewNote           String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([userId])
  @@index([campaignId])
  @@index([userId, approvalStatus])
  @@map("ad_creatives")
}

/// A prospect from outbound/growth work — one row per real business contacted,
/// independent of whether they ever create a ForgeVid account. Optionally
/// attributed to the AdCreative (sample video) sent to them, so revenue can
/// trace back to the specific campaign that produced it. `isRelatedParty`
/// keeps friends/family pilots out of judged arms-length revenue by
/// construction instead of relying on manual bookkeeping.
model Lead {
  id                 String     @id @default(cuid())
  userId             String
  creativeId         String?
  vertical           String
  businessName       String
  contactName        String?
  contactEmail       String?
  contactPhone       String?
  source             String
  status             LeadStatus @default(NEW)
  isRelatedParty     Boolean    @default(false)
  revenueCents       Int?
  currency           String     @default("usd")
  testimonialConsent Boolean    @default(false)
  notes              String?
  sampleSentAt       DateTime?
  convertedAt        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([userId])
  @@index([creativeId])
  @@index([status])
  @@map("leads")
}

enum LeadStatus {
  NEW
  SAMPLE_SENT
  REPLIED
  MEETING
  PILOT
  PAID
  RETAINED
  DEAD
}

/// One inventory item (vehicle/listing/product) tracked ACROSS feed pulls, so
/// price changes, days-in-inventory and "no recent video" can be detected —
/// none of which is possible from a single stateless batch request. Keyed on
/// the feed's own reference so re-importing the same feed updates the same
/// row instead of creating a duplicate.
model InventoryItem {
  id          String    @id @default(cuid())
  userId      String
  vertical    String // "auto" | "realestate" | "ecom"
  externalRef String // the feed's own id: VIN/stock#, listing ref, SKU
  label       String
  priceText   String? // raw, never parsed to a number — see lib/inventory.ts
  photoCount  Int       @default(0)
  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  removedAt   DateTime? // set when a feedUrl refresh no longer lists this ref
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  snapshots   InventorySnapshot[]

  @@unique([userId, vertical, externalRef])
  @@index([userId, vertical])
  @@map("inventory_items")
}

/// One point-in-time observation of an InventoryItem, one per batch run it
/// appeared in. Diffing consecutive snapshots is how a price change is
/// detected — as a text-inequality fact, never a parsed/interpreted number
/// (a wrong "price dropped 20%" claim about a real business's real listing
/// would be worse than not claiming anything).
model InventorySnapshot {
  id        String        @id @default(cuid())
  itemId    String
  item      InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  priceText String?
  label     String
  videoId   String? // the Video this particular pull produced, if any
  createdAt DateTime      @default(now())

  @@index([itemId])
  @@map("inventory_snapshots")
}

/// A customer-authorized recurring inventory connection. Secrets are stored as
/// one AES-GCM encrypted JSON blob and are never returned by an API.
model InventorySource {
  id                   String    @id @default(cuid())
  userId               String
  name                 String
  vertical             String
  feedUrl              String
  credentialCiphertext String?
  fieldMapping         String?   // JSON object: ForgeVid field -> source field
  authorizationBasis   String
  authorizationExpiresAt DateTime?
  enabled              Boolean   @default(true)
  scheduleEnabled      Boolean   @default(false)
  cadence              String    @default("daily")
  nextRunAt             DateTime?
  lastRunAt             DateTime?
  lastSuccessAt         DateTime?
  lastError             String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  runs InventoryImportRun[]

  @@index([userId, enabled])
  @@index([scheduleEnabled, nextRunAt])
  @@map("inventory_sources")
}

model InventoryImportRun {
  id         String          @id @default(cuid())
  sourceId   String
  source     InventorySource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  status     String          @default("PENDING")
  itemsRead  Int             @default(0)
  itemsValid Int             @default(0)
  itemsFailed Int            @default(0)
  errorArchive String?       // JSON array of row-safe validation errors
  startedAt  DateTime        @default(now())
  finishedAt DateTime?

  @@index([sourceId, startedAt])
  @@map("inventory_import_runs")
}

/// Rights provenance for each customer-supplied inventory asset.
model InventoryAssetAuthorization {
  id            String    @id @default(cuid())
  userId        String
  inventoryItemId String?
  assetUrl      String
  sourceUrl     String?
  authorizationBasis String
  authorizedBy  String?
  expiresAt     DateTime?
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([userId, assetUrl])
  @@index([userId, revokedAt, expiresAt])
  @@index([inventoryItemId])
  @@map("inventory_asset_authorizations")
}

model GrowthScoringSettings {
  id                 String   @id @default(cuid())
  userId             String   @unique
  agingWeight        Int      @default(1)
  missingVideoWeight Int      @default(30)
  priceChangeWeight  Int      @default(25)
  newArrivalWeight   Int      @default(15)
  seasonalWeight     Int      @default(0)
  seasonalMonths     String   @default("[]")
  revenueAtRiskMethod String  @default("none")
  revenueAtRiskWeight Int     @default(0)
  updatedAt          DateTime @updatedAt
  createdAt          DateTime @default(now())

  @@map("growth_scoring_settings")
}

model DiscountCode {
  id             String    @id @default(cuid())
  code           String    @unique
  stripeCouponId String
  percentOff     Int?
  amountOffCents Int?
  currency       String    @default("usd")
  maxRedemptions Int?
  redemptions    Int       @default(0)
  active         Boolean   @default(true)
  expiresAt      DateTime?
  createdBy      String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([active, expiresAt])
  @@map("discount_codes")
}

model DiscountRedemption {
  id              String   @id @default(cuid())
  discountCodeId  String
  stripeSessionId String   @unique
  userId          String
  createdAt       DateTime @default(now())

  @@index([discountCodeId])
  @@map("discount_redemptions")
}

model CampaignDomain {
  id                String    @id @default(cuid())
  userId            String
  hostname          String    @unique
  verificationToken String
  verifiedAt        DateTime?
  defaultCreativeId String?
  enabled           Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([userId, enabled])
  @@map("campaign_domains")
}

/// A view or lead-submission on a public /l/[creativeId] landing page. The
/// AdCreative's own cuid id doubles as the public link segment — already
/// unguessable, no separate slug/token needed.
model CreativeEvent {
  id         String   @id @default(cuid())
  creativeId String
  kind       String // "view" | "lead_submitted"
  // Only present when kind = "lead_submitted" — a visitor interested in the
  // AdCreative owner's product/listing, NOT a Lead row (which is ForgeVid's
  // own outbound sales pipeline; conflating the two would pollute arms-length
  // revenue tracking with a ForgeVid customer's downstream visitor data).
  name       String?
  email      String?
  phone      String?
  message    String?
  createdAt  DateTime @default(now())

  @@index([creativeId])
  @@map("creative_events")
}

/// A customer-recorded downstream outcome attributed to an approved creative.
/// Revenue is never inferred: the customer supplies the event and amount.
model GrowthConversion {
  id            String   @id @default(cuid())
  userId        String
  creativeId    String
  kind          String   // "qualified_lead" | "appointment" | "sale" | "retained"
  source        String   @default("manual") // "manual" | "csv" | "crm"
  externalId    String?
  contactRef    String?  // customer-controlled non-sensitive reference
  revenueCents  Int?
  currency      String   @default("usd")
  notes         String?
  occurredAt    DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, occurredAt])
  @@index([creativeId])
  @@unique([userId, source, externalId])
  @@map("growth_conversions")
}

/// Customer-owned assumptions used for illustrative savings estimates.
model ImpactAssumption {
  id                         String   @id @default(cuid())
  userId                     String   @unique
  minutesPerTraditionalVideo Int      @default(120)
  agencyCostPerVideoCents    Int      @default(50000)
  updatedAt                  DateTime @updatedAt
  createdAt                  DateTime @default(now())

  @@map("impact_assumptions")
}

model GrowthOperatorSchedule {
  id              String   @id @default(cuid())
  userId          String   @unique
  enabled         Boolean  @default(false)
  cadence         String   @default("daily") // "daily" | "weekly"
  emailEnabled    Boolean  @default(true)
  maxDecisions    Int      @default(1)
  nextRunAt       DateTime?
  lastRunAt       DateTime?
  lastError       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([enabled, nextRunAt])
  @@map("growth_operator_schedules")
}

/// Tamper-evident, append-only audit chain. Database triggers reject UPDATE
/// and DELETE so corrections are represented by superseding records.
model EvidenceRecord {
  id             String   @id @default(cuid())
  sequence       BigInt   @unique
  kind           String
  entityType     String?
  entityId       String?
  actorUserId    String?
  payload        String
  payloadHash    String
  previousHash   String
  recordHash     String   @unique
  supersedesId   String?
  createdAt      DateTime @default(now())

  @@index([kind, createdAt])
  @@index([entityType, entityId])
  @@map("evidence_records")
}

model CampaignApprovalEvent {
  id              String   @id @default(cuid())
  creativeId      String
  revision        Int
  action          String
  actorUserId     String
  rightsConfirmed Boolean  @default(false)
  note            String?
  snapshot        String
  snapshotHash    String
  createdAt       DateTime @default(now())

  @@index([creativeId, revision, createdAt])
  @@index([actorUserId, createdAt])
  @@map("campaign_approval_events")
}

model GenerationDeadLetter {
  id          String   @id @default(cuid())
  userId      String
  videoId     String
  kind        String
  jobData     String
  error       String
  attempts    Int
  status      String   @default("PENDING") // "PENDING" | "REPLAYED" | "RESOLVED"
  replayedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, status, createdAt])
  @@index([videoId])
  @@map("generation_dead_letters")
}

/// Non-AI operating costs — hosting, contractor, tool subscriptions, paid
/// marketing spend — kept separate from AIGeneration.cost (API cost only) so
/// the evidence dashboard can report a real P&L, not just inference cost.
/// Entered by hand; nothing here is inferred or auto-charged.
model OperatingCost {
  id          String   @id @default(cuid())
  userId      String
  category    String // "hosting" | "contractor" | "tooling" | "marketing_spend" | "other"
  description String
  amountCents Int
  currency    String   @default("usd")
  incurredOn  DateTime
  notes       String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([incurredOn])
  @@map("operating_costs")
}

